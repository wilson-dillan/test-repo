# Copy this file to .env (which git ignores) to send real email locally
# through Google Workspace. Without it, emails go to the practice inbox at
# http://mail.localhost instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=dillan@wilsonph.com
SMTP_PASSWORD=your-16-character-app-password
MAIL_FROM=Wilson Services <dillan@wilsonph.com>
